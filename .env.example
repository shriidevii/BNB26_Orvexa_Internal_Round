# ============================================================
# TrustLayer Environment Configuration
# ============================================================

# Application
TRUSTLAYER_ENV=dev
TRUSTLAYER_DEVICE=auto

# Data
TRUSTLAYER_DATA_DIR=data
TRUSTLAYER_MODEL_DIR=models
TRUSTLAYER_FEATURE_DIR=features
TRUSTLAYER_RESULTS_DIR=results

# Hugging Face
# Add your token only to .env, NEVER to this file.
HF_TOKEN=

# Optional LLM explanation layer
# Add the appropriate API key only to your local .env.
GEMINI_API_KEY=

# Optional OpenAI-compatible endpoint
OPENAI_API_KEY=

# Reproducibility
TRUSTLAYER_SEED=42

# Logging
TRUSTLAYER_LOG_LEVEL=INFO